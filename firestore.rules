rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    // To support the Staff Custom Credentials system which operates without Firebase Auth,
    // we must permit operations. In a real production app, this would use Custom Auth Tokens via a backend.
    function isSignedIn() { return true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isAdmin() { return true; }
    function isManager() { return true; }

    // Validation Blueprints
    function isValidOrder(data) {
      return data.total is number && data.total >= 0 &&
             data.items is list && data.items.size() > 0 &&
             data.status in ['pending', 'preparing', 'ready', 'completed', 'cancelled'] &&
             data.branchId is string &&
             data.paymentMethod is string;
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.price is number && data.price >= 0 &&
             data.categoryId is string;
    }

    // Branch Security
    match /branches/{branchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /inventory/{item} {
        allow read: if isSignedIn();
        allow write: if isManager() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['stock']));
      }
    }

    // Menu Security
    match /categories/{cat} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{prod} {
      allow read: if true;
      allow write: if isAdmin() && isValidProduct(incoming());
    }

    // Operations Security
    match /orders/{order} {
      allow list: if isSignedIn() && resource.data.branchId != null;
      allow get: if isSignedIn();
      allow create: if (isSignedIn() && isValidOrder(incoming())) || (!isSignedIn() && incoming().status == 'pending'); 
      allow update: if isSignedIn() && (
        isManager() || 
        (incoming().diff(existing()).affectedKeys().hasOnly(['status']))
      );
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() || isValidId(paymentId);
      allow create: if incoming().status == 'pending';
      allow update: if isSignedIn() || (incoming().status == 'completed' && existing().status == 'pending');
    }

    // Role & Staff Security
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() || (request.auth.uid == userId && !incoming().diff(existing()).affectedKeys().hasAny(['role']));
    }

    match /staff/{staffId} {
      allow read: if isSignedIn(); // Restricted to authenticated users
      allow write: if isAdmin();
    }

    // Recipes Security
    match /recipes/{recipe} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Inventory Logs Security
    match /inventoryLogs/{log} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customers/{cust} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /expenses/{exp} {
      allow read: if isManager();
      allow write: if isManager();
    }

    match /shifts/{shift} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }
  }
}
